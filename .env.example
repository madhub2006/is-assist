# ==========================================================
# IS-Assist Environment Configuration (.env.example)
# AI-Powered Indian Standards & Procurement Intelligence
# ==========================================================

# Application Settings
PROJECT_NAME="IS-Assist"
TAGLINE="AI-Powered Indian Standards & Procurement Intelligence"
ENVIRONMENT=development
IS_PHASE_1=true
EMBEDDING_MODEL="all-MiniLM-L6-v2"
LLM_API_KEY=""
LLM_MODEL=""
LLM_API_URL="https://api.openai.com/v1/chat/completions"

# Security & JWT Token
SECRET_KEY="is-assist-super-secret-production-key-change-in-env-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL Production:
# DATABASE_URL="postgresql+psycopg2://is_assist_user:is_assist_secure_password_2026@localhost:5432/is_assist_db"
# Local SQLite Zero-Config Development:
DATABASE_URL="sqlite:///./is_assist.db"

# CORS Configuration
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
VITE_API_URL=""

# Document Upload Directory & Limits
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=26214400
