{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:match*", "destination": "https://api-production-d266.up.railway.app/api/:match*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}