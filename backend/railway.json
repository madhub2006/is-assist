{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["app/**", "requirements.txt", "alembic/**"]
  },
  "deploy": {
    "startCommand": "python -m app.seed_production && uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}